{{ nginx_site_marker }}
# {{ ansible_managed }}
# {{ item.server_name }} -> {{ item.upstream }}{{ ' (websocket)' if item.websocket | default(false) else '' }}
server {
	listen {{ item.listen | default('127.0.0.1:8080', true) }};
	server_name {{ item.server_name }};

	location / {
		proxy_pass {{ item.upstream }};
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header X-Forwarded-Proto $edge_forwarded_proto;
		# The client address after the real IP check, never an address list from the request.
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $remote_addr;
		proxy_set_header {{ nginx_real_ip_header }} $remote_addr;
		# A Forwarded header (RFC 7239) from the request could name any address: not passed on.
		proxy_set_header Forwarded "";
{% if item.websocket | default(false) %}
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_read_timeout {{ nginx_websocket_read_timeout }};
{% else %}
		proxy_set_header Connection "";
{% endif %}
	}
}
