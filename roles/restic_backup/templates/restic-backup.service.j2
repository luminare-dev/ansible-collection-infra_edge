# {{ ansible_managed }} (luminare.infra_edge.restic_backup)
# Backs up {{ restic_backup_paths | join(', ') }} with restic ({{ restic_backup_script }}), then applies the
# retention and records the time of the run. Started by restic-backup.timer, or by hand with
# "systemctl start restic-backup.service". After the dumps of the mariadb role when both start
# together (for example after a boot that missed both).
[Unit]
Description=Back up this host with restic
Wants=network-online.target
After=network-online.target mariadb-dump.service

[Service]
Type=oneshot
ExecStart={{ restic_backup_script }}
User=root
UMask=0077
Nice=10
IOSchedulingClass=idle

