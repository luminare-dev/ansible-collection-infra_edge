# {{ ansible_managed }} (luminare.infra_edge.restic_backup)
# Settings of the restic repository of this host, read by {{ restic_backup_wrapper }} for every
# restic run (the backup and check services, the restore test and runs by hand). Root only: it
# holds the repository address and the backend credentials. Shell syntax, every value quoted.
RESTIC_REPOSITORY={{ restic_backup_repository | quote }}
RESTIC_PASSWORD_FILE={{ restic_backup_password_file | quote }}
RESTIC_CACHE_DIR={{ restic_backup_cache_dir | quote }}
{% for name, value in restic_backup_env | dictsort %}
{{ name }}={{ value | string | quote }}
{% endfor %}
