# {{ ansible_managed }} (luminare.infra_edge.mariadb)
# Starts mariadb-dump.service at {{ mariadb_dump_oncalendar }} (systemd calendar, local time of
# the host). Persistent: a run missed while the host was off follows at the next boot.
[Unit]
Description=Nightly dumps of the MariaDB databases

[Timer]
OnCalendar={{ mariadb_dump_oncalendar }}
Persistent=true

[Install]
WantedBy=timers.target
