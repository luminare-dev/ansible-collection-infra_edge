# {{ ansible_managed }} (luminare.infra_edge.cloudflared)
# Connector of a remotely managed tunnel. The token is read from {{ cloudflared_token_file }}
# (mode 0600, owner {{ cloudflared_user }}); it is never on the command line.
[Unit]
Description=Cloudflare Tunnel connector (remotely managed tunnel)
Documentation=https://developers.cloudflare.com/cloudflare-one/networks/connectors/cloudflare-tunnel/
After=network-online.target
Wants=network-online.target

[Service]
# cloudflared reports readiness when the tunnel has its first connection to the edge.
Type=notify
TimeoutStartSec=30s
User={{ cloudflared_user }}
Group={{ cloudflared_user }}
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --metrics {{ cloudflared_metrics_address }}{% for arg in cloudflared_extra_args %} {{ arg }}{% endfor %} run --token-file {{ cloudflared_token_file }}
Restart=on-failure
RestartSec=5s

# Sandbox: no capabilities, read-only system, no home directories, private /tmp and /dev, only
# the address families and system calls a network service needs.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
