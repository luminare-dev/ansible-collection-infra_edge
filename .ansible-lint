# ansible-lint configuration (https://docs.ansible.com/projects/lint/configuring/).
# CI runs "ansible-lint" from the repository root in the lint-test job (ci.yml).
profile: production
# ansible-lint 26.10.1 knows ansible-core 2.15 to 2.19 as supported (meta-runtime rule); this
# collection requires and is tested with 2.21 (meta/runtime.yml, docs/adr/0007).
supported_ansible_also:
  - "2.21."
# Files that are not Ansible content, and caches and build output.
exclude_paths:
  - .ansible/
  - .cache/
  - .github/
  - dist/
  - docs/brand/
  - tests/fixtures/
