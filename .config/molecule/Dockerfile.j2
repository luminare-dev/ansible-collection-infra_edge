# Molecule test image for every role scenario: systemd as PID 1 plus what Ansible needs on a
# managed host. The base images are pinned by digest (Dependabot "docker" updates the digests;
# docs/adr/0006). The Molecule docker driver renders this file once per platform, and
# .config/molecule/config.yml sets "image" to one of the two names below.
{% if item.image == 'ie-molecule-debian13' %}
FROM debian:trixie@sha256:4c25275446ca371766b8b093c696782eabce06263fccacb8d5d813b3dc44b308
{% elif item.image == 'ie-molecule-ubuntu2404' %}
FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
{% endif %}

ENV container=docker

# Units that only make sense on real hardware or with a console are removed, and kernel module
# loading (not possible in a container) is masked, so that "systemctl is-system-running"
# reports "running" in the container.
RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates iproute2 procps python3 python3-apt sudo systemd systemd-sysv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/machine-id /var/lib/dbus/machine-id \
    && find /etc/systemd/system /lib/systemd/system \
       \( -name 'getty*' -o -name 'systemd-udev*' -o -name 'systemd-firstboot*' \) -type l -delete \
    && systemctl mask systemd-modules-load.service

STOPSIGNAL SIGRTMIN+3
CMD ["/lib/systemd/systemd"]
